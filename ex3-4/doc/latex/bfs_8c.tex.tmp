\doxysubsubsection{\texorpdfstring{breadth\_first\_visit()}{breadth\_first\_visit()}}
{\footnotesize\ttfamily void \texorpdfstring{$\ast$}{*}\texorpdfstring{$\ast$}{*} breadth\+\_\+first\+\_\+visit (\begin{DoxyParamCaption}\item[{\mbox{\hyperlink{structgraph}{Graph}} \texorpdfstring{$\ast$}{*}}]{gr,  }\item[{void \texorpdfstring{$\ast$}{*}}]{start,  }\item[{int(\texorpdfstring{$\ast$}{*})(const void \texorpdfstring{$\ast$}{*}, const void \texorpdfstring{$\ast$}{*})}]{compare,  }\item[{unsigned long(\texorpdfstring{$\ast$}{*})(const void \texorpdfstring{$\ast$}{*})}]{hash }\end{DoxyParamCaption})}



Performs a breadth-\/first search traversal of a graph. 

Performs breadth-\/first traversal of a graph.


\begin{DoxyParams}{Parameters}
{\em gr} & Pointer to the graph structure \\
\hline
{\em start} & Pointer to the starting node \\
\hline
{\em compare} & Function pointer to compare two nodes \\
\hline
{\em hash} & Function pointer to generate hash value for a node \\
\hline
\end{DoxyParams}
\begin{DoxyReturn}{Returns}
NULL-\/terminated array of pointers to visited nodes in BFS order, or NULL if an error occurs
\end{DoxyReturn}
Implements the breadth-\/first search algorithm using a queue. The function measures and prints the execution time. The returned array must be freed by the caller.

\begin{DoxyNote}{Note}
The hash parameter is used for compatibility with the graph interface but is not essential for the BFS algorithm itself. 
\end{DoxyNote}


